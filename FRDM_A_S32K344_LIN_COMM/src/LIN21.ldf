/*---------GLOBAL DEFINITIONS-----------*/
LIN_description_file;
LIN_protocol_version             = "2.1";
LIN_language_version             = "2.1";
LIN_speed                        = 19.2 kbps;
/* ----------NODE DEFINITIONS---------- */
Nodes {
   Master:
      CommMaster,                                               /* Master node name */
      5 ms,                                                     /* Time base */
      0.1 ms;                                                   /* Jitter */
   Slaves:
      CommSlave;
}
/* ----------SIGNAL DEFINITIONS---------- */
Signals {
   /* Signal_name         : Size,  Init,  Publisher,  Subscriber(s) */
   MasterCommand          :  8,    0x00,  CommMaster, CommSlave;
   SlaveStatus            :  8,    0x00,  CommSlave,  CommMaster;
   SlaveCommError         :  1,    0x00,  CommSlave,  CommMaster;
}
/* ----------DIAGNOSTIC SIGNAL DEFINITIONS---------- */
Diagnostic_signals {
   /* MasterReq Reserved Signals */
   MasterReqB0         :    8,   0;
   MasterReqB1         :    8,   0;
   MasterReqB2         :    8,   0;
   MasterReqB3         :    8,   0;
   MasterReqB4         :    8,   0;
   MasterReqB5         :    8,   0;
   MasterReqB6         :    8,   0;
   MasterReqB7         :    8,   0;
   /* SlaveResp Reserved Signals */
   SlaveRespB0         :    8,   0;
   SlaveRespB1         :    8,   0;
   SlaveRespB2         :    8,   0;
   SlaveRespB3         :    8,   0;
   SlaveRespB4         :    8,   0;
   SlaveRespB5         :    8,   0;
   SlaveRespB6         :    8,   0;
   SlaveRespB7         :    8,   0;
}
/* ----------UNCONDITIONAL FRAME DEFINITIONS---------- */
Frames {
   CommMasterCmd       : 0x30, CommMaster  ,    1 {
      MasterCommand       , 0;
   }
   CommSlaveStatus     : 0x33, CommSlave   ,    2 {
      SlaveStatus         , 0;
      SlaveCommError      , 8;
   }
}
/* ----------DIAGNOSTIC FRAME DEFINITIONS---------- */
Diagnostic_frames {
   MasterReq           : 0x3C {
      MasterReqB0         , 0;
      MasterReqB1         , 8;
      MasterReqB2         , 16;
      MasterReqB3         , 24;
      MasterReqB4         , 32;
      MasterReqB5         , 40;
      MasterReqB6         , 48;
      MasterReqB7         , 56;
   }
   SlaveResp           : 0x3D {
      SlaveRespB0         , 0;
      SlaveRespB1         , 8;
      SlaveRespB2         , 16;
      SlaveRespB3         , 24;
      SlaveRespB4         , 32;
      SlaveRespB5         , 40;
      SlaveRespB6         , 48;
      SlaveRespB7         , 56;
   }
}
/* ----------NODE ATTRIBUTE DEFINITIONS---------- */
Node_attributes {
   CommSlave {
      LIN_protocol               = "2.1";                    /* Node protocol version */
      configured_NAD             = 0x02;                     /* configured NAD of node */
      initial_NAD                = 0x0A;                     /* initial NAD of node */
      product_id                 = 0x1E, 0x01, 0x00;         /* Product id */
      response_error             = SlaveCommError;           /* Response error signal */
      P2_min                     = 100 ms;                   /* P2_min */
      ST_min                     = 20 ms;                    /* ST_min */
      N_As_timeout               = 1000 ms;                  /* N_As_timeout */
      N_Cr_timeout               = 1000 ms;                  /* N_Cr_timeout */
      configurable_frames {
         CommMasterCmd;
         CommSlaveStatus;
      }
   }
}
/* ----------SCHEDULE TABLE DEFINITIONS---------- */
Schedule_tables {
   NormalTable {
      CommMasterCmd                                          delay 50 ms;
      CommSlaveStatus                                        delay 50 ms;
   }
}
